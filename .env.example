FINOSCALE_API_KEY=fsk_live_your_key_here
FINOSCALE_API_BASE=https://api-ppe.finoscale.ai

# --- LLM review loop (vdd/review/) ---------------------------------------
# Gemini is the tested provider today. Set OPENAI_API_KEY + OPENAI_MODEL to
# swap providers -- see vdd/review/model.py. With both keys present Gemini
# wins unless LLM_PROVIDER=openai. Leave both unset to skip the review step
# entirely (deterministic-only report).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=
# OPENAI_MODEL=            # no default on purpose, e.g. gpt-5.6-luna (nano tier) / gpt-5.6-terra (mini tier)
# OPENAI_REASONING_EFFORT= # none|low|medium|high|xhigh|max; default medium. Summaries need a verified OpenAI org.
# LLM_PROVIDER=            # optional override: "gemini" or "openai"

# Tavily web-search tool for the reviewer agent (~1000 searches/month on
# the free tier). Swap point for later: once this project moves its LLM
# provider to OpenAI in production, the reviewer's web_search tool can be
# repointed at OpenAI's own hosted web-search tool instead (see
# vdd/review/tools.py::web_search's docstring) -- that is a code change,
# not just a new key, so TAVILY_API_KEY stays supported either way.
TAVILY_API_KEY=

# --- Tracing -- DO NOT SET THESE ------------------------------------------
# This pipeline processes consented but highly sensitive personal
# financial/KYC data. LangChain/LangSmith tracing must stay off -- never
# set LANGCHAIN_TRACING_V2, LANGCHAIN_API_KEY, or any LANGSMITH_* variable.
# vdd/review/__init__.py raises immediately at import time if it detects
# tracing has been turned on.
