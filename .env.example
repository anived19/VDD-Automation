FINOSCALE_API_KEY=fsk_live_your_key_here
FINOSCALE_API_BASE=https://api-ppe.finoscale.ai

# --- LLM review loop (vdd/review/) ---------------------------------------
# Three providers -- see vdd/review/model.py. Precedence when several are
# configured: LLM_PROVIDER if set, else foundry > gemini > openai. Leave all
# unset to skip the review step entirely (deterministic-only report).
# LLM_PROVIDER=            # "foundry" | "gemini" | "openai"

# Gemini (tested): gemini-3.5-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI (tested 2026-09-16): Responses API with reasoning summaries.
# OPENAI_API_KEY=
# OPENAI_MODEL=            # no default on purpose, e.g. gpt-5.6-luna (nano tier) / gpt-5.6-terra (mini tier)
# OPENAI_REASONING_EFFORT= # none|low|medium|high|xhigh|max; default medium. Summaries need a verified OpenAI org.

# Microsoft Foundry (data-residency path): an open-weight model sold and
# hosted by Azure inside our own subscription. The model's maker never sees
# a request; Microsoft does not train on, share, or (with the exemption
# below) store prompts and completions.
#
#   Deployment checklist -- the guarantees only hold if all of these are done:
#     1. Deploy the model as a "Foundry Model sold directly by Azure" -- NOT a
#        third-party-hosted listing of the same model (those route data to
#        that host).
#     2. Deployment type Standard/regional (India if offered) or Data Zone
#        Asia Pacific. Never Global -- that may process in any region.
#     3. Apply for the modified abuse-monitoring exemption on the resource.
#        Without it, flagged prompts/completions can be retained for review.
#     4. Public network access off + Private Link; leave Azure diagnostic
#        request/response logging OFF (it is opt-in).
#     5. Use the resource's OpenAI-compatible endpoint (the /openai/v1 route).
#
# FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
# FOUNDRY_API_KEY=
# FOUNDRY_DEPLOYMENT=      # deployment name from the portal, e.g. DeepSeek-V4-Pro / Kimi-K3
# FOUNDRY_API_VERSION=     # only if the endpoint route requires ?api-version=
# FOUNDRY_MAX_OUTPUT_TOKENS=8192   # per-turn cap; a reasoning model's thinking counts against it
# FOUNDRY_MAX_MODEL_CALLS=8        # per-pass cap; the last call is forced to be the ReviewReport
# FOUNDRY_EXTRA_BODY=      # JSON of model-specific request fields from the model card,
                           # e.g. {"thinking": {"type": "enabled"}} -- never guessed in code

# Web search for the reviewer (Tavily). OFF unless REVIEW_WEB_SEARCH=1: the
# model composes the query itself and has been observed putting a PAN and a
# premises address into it, which then goes to a party that is not a KYC data
# source. Every trace to date reached 4/4 recall without it.
# REVIEW_WEB_SEARCH=0
TAVILY_API_KEY=

# --- Tracing -- DO NOT SET THESE ------------------------------------------
# This pipeline processes consented but highly sensitive personal
# financial/KYC data. LangChain/LangSmith tracing must stay off -- never
# set LANGCHAIN_TRACING_V2, LANGCHAIN_API_KEY, or any LANGSMITH_* variable.
# vdd/review/__init__.py raises immediately at import time if it detects
# tracing has been turned on.
